{
  "manifest_version": 3,
  "name": "KuralCheck — Tamil Speech Tester",
  "short_name": "KuralCheck",
  "version": "1.0.0",
  "description": "Test how Gnani Prisma hears Tamil on clean and noisy phone lines, score transcripts and apply the KuralCheck fix layer.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "KuralCheck",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "devtools_page": "devtools.html",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
