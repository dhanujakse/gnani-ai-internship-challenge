<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: encrypted connections only (https / wss), and only certificates the system trusts
     (no user-installed certificates, so traffic cannot be read by installing a fake certificate). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
