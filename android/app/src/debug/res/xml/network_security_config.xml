<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (testing): plain http is allowed so a phone can reach a development server on the
     local Wi-Fi (e.g. http://192.168.1.20:8787), and user-installed certificates are trusted for debugging
     tools. Release builds use src/main/res/xml/network_security_config.xml: https only, system certificates. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
