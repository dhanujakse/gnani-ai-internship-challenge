# Sarvagyan server configuration. Copy to .env and fill in. Never commit .env.

# Gnani Speech APIs (Prisma streaming STT + Timbre streaming TTS) — required for translation
GNANI_API_KEY=

# MyMemory translation (no key needed). An email raises the free quota from 5,000 to 50,000 chars/day.
MYMEMORY_EMAIL=

# Signs login tokens. Use a long random string in production (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
AUTH_SECRET=

# Hackathon demo mode: allows "Continue as guest" sign-in. Set false in production.
DEMO_MODE=true

# WebRTC connectivity. STUN works on most networks; add a TURN server for strict NATs / mobile data.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Preferred with coturn (use-auth-secret): per-user TURN credentials valid 24 h instead of one fixed password
TURN_SECRET=
# true when the server is reached through cloudflared / Cloudflare (rate limits use the real client address)
TRUST_PROXY_HEADERS=false

# Websites allowed to call the API from a browser (the Sarvagyan web app). Comma-separated, no trailing slash.
WEB_ORIGINS=https://gnani-ai-internship-challenge.vercel.app,http://localhost:3000

# Where the server keeps its SQLite database (users and call metadata only — no audio, no transcripts)
DATA_DIR=server/data

# Spending the paid speech APIs carefully (server/sarvagyan_server/credits.py). 0 = no limit.
STT_SILENCE_GATE=true           # send only speech (with a short lead-in and tail) to speech recognition
STT_IDLE_CLOSE_S=20             # close the recognition stream after this much silence; it reopens on speech
DAILY_STT_MINUTES_PER_USER=120
DAILY_TTS_CHARS_PER_USER=30000  # after this, the call carries on with subtitles only
DAILY_SERVER_STT_MINUTES=0
DAILY_SERVER_TTS_CHARS=0
TTS_CACHE_MB=32                 # generated voice for short repeated phrases, memory only
ADMIN_TOKEN=                    # set to read today's usage: GET /v1/admin/usage with header X-Admin-Token
